# 16 MB flash: two 1792 KB OTA app slots, the file system after them
# (~12.4 MB); the table is partitions-ota.csv (mpconfigboard.cmake)

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

CONFIG_PARTITION_TABLE_CUSTOM=y

# no BLE: the logger never uses it (~300 KB of the app, and the
# controller's RAM)
CONFIG_BT_ENABLED=n
