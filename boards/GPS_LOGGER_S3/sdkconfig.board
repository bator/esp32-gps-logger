# 8 MB flash: two 1792 KB OTA app slots, the file system after them (~4.4 MB);
# the table is partitions-ota.csv (mpconfigboard.cmake)

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

CONFIG_PARTITION_TABLE_CUSTOM=y

# no BLE: the logger never uses it (~300 KB of the app, and the
# controller's RAM)
CONFIG_BT_ENABLED=n

# the OTA health check and the crash rollback need the bootloader's
# rollback (an image boots pending until gps_logger confirms it); pinned
# here, not left to the port's sdkconfig.base
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
